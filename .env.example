# ==========================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO GAME MA SÓI
# ==========================================

# Server Port & CORS
PORT=3001
CORS_ORIGIN=http://localhost:3000

# PostgreSQL Database (Prisma)
POSTGRES_USER=werewolf
POSTGRES_PASSWORD=werewolf_secret
POSTGRES_DB=werewolf_db
DATABASE_URL="postgresql://werewolf:werewolf_secret@localhost:5432/werewolf_db?schema=public"

# Redis In-Memory State & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=werewolf_redis_pass

# Security & JWT Token
JWT_SECRET=werewolf_super_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Frontend Next.js Public Env
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
